{
  "expo": {
    "name": "CardSync",
    "slug": "cardsync",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "scheme": "cardsync",
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juanycorn.cardsync"
    },
    "android": {
      "package": "com.juanycorn.cardsync",
      "adaptiveIcon": {
        "backgroundColor": "#090B10"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
